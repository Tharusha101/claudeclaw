// Copy this file to `secrets.h` (which is gitignored) and fill in your values.
// Only the WiFi build (env esp32-c3-wifi) uses it.

#pragma once

#define WIFI_SSID "your-wifi-or-phone-hotspot"
#define WIFI_PASS "your-wifi-password"

// Must match KEYTAG_TOKEN in the bridge's environment. Make it long and random,
// e.g. `python -c "import secrets; print(secrets.token_urlsafe(24))"`.
#define KEYTAG_TOKEN "change-me-to-a-long-random-secret"

// The bridge, as reachable from the keytag.
//   LAN test:  your PC's IP, port 8787, BRIDGE_TLS 0  (plain ws://)
//   tunnel:    the tunnel host, port 443, BRIDGE_TLS 1 (wss://, e.g. Cloudflare)
#define BRIDGE_HOST "192.168.1.50"
#define BRIDGE_PORT 8787
#define BRIDGE_TLS 0  // 1 = wss:// (required for a Cloudflare/ngrok tunnel)

// Optional but recommended for "away" use: pin the ROOT CA (PEM) of your tunnel
// host's cert to VALIDATE it (prevents MITM). Get it once your named tunnel is
// up — see tunnel/README.md. Without it, wss is encrypted but the cert is not
// checked. (The firmware NTP-syncs time automatically so the cert dates verify.)
// Note: it's a variable + a flag, NOT a bare #define — a multi-line raw string
// inside a #define breaks the preprocessor.
// #define BRIDGE_HAS_CA 1
// static const char BRIDGE_CA_CERT[] = R"EOF(
// -----BEGIN CERTIFICATE-----
// ...root CA...
// -----END CERTIFICATE-----
// )EOF";
